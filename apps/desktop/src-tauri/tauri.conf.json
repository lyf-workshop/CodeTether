{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeTether",
  "version": "../../../package.json",
  "identifier": "com.codetether.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CodeTether",
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "backgroundColor": "#07111f",
        "useHttpsScheme": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "base-uri": "'none'",
        "default-src": "'self'",
        "connect-src": "http://127.0.0.1:4317",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "img-src": "'self' data: blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "base-uri": "'none'",
        "default-src": "'self'",
        "connect-src": "http://127.0.0.1:4317 http://127.0.0.1:5173 ws://127.0.0.1:5173",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "img-src": "'self' data: blob:",
        "object-src": "'none'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/codetether-host"],
    "shortDescription": "Local workspace for Codex coding agents",
    "longDescription": "CodeTether manages local Codex projects, conversations, approvals, and durable history.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
