{
  "name": "@codetether/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "pnpm build && node --test --test-isolation=none test/*.test.mjs",
    "spike": "node dist/spike.js",
    "semantics": "node dist/semantics.js",
    "serve": "node dist/serve.js",
    "observe": "node dist/live-read.js",
    "control": "node dist/control.js",
    "integration": "node dist/integration.js",
    "conversation-hydration": "node dist/conversation-hydration-integration.js",
    "attention-integration": "node dist/attention-integration.js",
    "claude-code-integration": "node dist/claude-code-integration.js",
    "claude-code-capability-integration": "node dist/claude-code-capability-integration.js"
  },
  "dependencies": {
    "@codetether/adapter-claude": "workspace:*",
    "@codetether/adapter-codex": "workspace:*",
    "@codetether/agent-core": "workspace:*",
    "@codetether/client": "workspace:*",
    "@codetether/machine-transport": "workspace:*",
    "@codetether/protocol": "workspace:*"
  }
}
