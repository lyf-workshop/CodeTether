{
  "name": "@codetether/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 --filter @codetether/relay... build && node --test --test-isolation=none test/*.test.mjs",
    "start": "node dist/main.js serve",
    "sea": "node scripts/build-relay.mjs"
  },
  "dependencies": {
    "@codetether/relay-protocol": "workspace:*",
    "selfsigned": "5.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
