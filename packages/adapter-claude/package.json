    "test": "pnpm build && node --test --test-isolation=none test/jsonl.test.mjs test/resolution.test.mjs test/detection.test.mjs test/normalizer.test.mjs test/runtime.test.mjs"
  },
  "dependencies": {
    "@codetether/agent-core": "workspace:*"
  }
}
