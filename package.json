{
  "name": "codetether-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A control center for AI coding agents.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @codetether/web dev",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codex:spike": "pnpm -r --workspace-concurrency=1 --filter @codetether/host... build && node apps/host/dist/spike.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
