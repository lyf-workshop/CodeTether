{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The CodeTether Web UI can select one Project directory and deliver bounded Attention notifications; it receives no shell or filesystem access.",
  "windows": ["main"],
  "permissions": [
    "allow-project-directory-picker",
    "allow-attention-notifications",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-focused",
    "core:window:allow-is-minimized",
    "core:window:allow-is-visible",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
